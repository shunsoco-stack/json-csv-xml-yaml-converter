{
  "name": "json-csv-xml-yaml-converter",
  "version": "1.0.0",
  "private": true,
  "description": "JSON・CSV・XML・YAMLをブラウザ内で検証・マッピング・変換するローカルファースト業務ツール",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "npm run build && node scripts/build-sites.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "encoding-japanese": "^2.2.0",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/encoding-japanese": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
